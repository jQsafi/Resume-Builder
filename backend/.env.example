# ResumePro Backend Environment Variables
# -------------------------------------------------------------
# Database Configuration:
# - Default SQLite (zero configuration): sqlite+aiosqlite:///./data/resumepro.db
# - PostgreSQL instance: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# Example: DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumepro
DATABASE_URL=sqlite+aiosqlite:///./data/resumepro.db

# JWT & Security
JWT_SECRET_KEY=resumepro-super-secret-jwt-key-2026-ats-authority
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application Environment (development / production)
ENVIRONMENT=development

# Groq Cloud LLM API Key (for high-speed AI bullet polish & ATS optimization)
GROQ_API_KEY=gsk_your_groq_api_key_here
